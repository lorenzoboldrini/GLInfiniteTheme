{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Minimal",
	"settings": {
		"layout": {
			"contentSize": "40rem",
			"wideSize": "64rem"
		},
		"color": {
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#ffffff" },
				{ "slug": "surface", "name": "Surface", "color": "#f5f5f5" },
				{ "slug": "contrast", "name": "Contrast", "color": "#111111" },
				{ "slug": "muted", "name": "Muted", "color": "#595959" },
				{ "slug": "accent", "name": "Accent", "color": "#262626" },
				{ "slug": "accent-contrast", "name": "Accent contrast", "color": "#ffffff" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "system-sans",
					"name": "System Sans",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "system-serif",
					"name": "System Serif",
					"fontFamily": "Georgia, \"Times New Roman\", serif"
				},
				{
					"slug": "system-mono",
					"name": "System Mono",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem" },
				{ "slug": "large", "name": "Large", "size": "1.3125rem", "fluid": { "min": "1.1875rem", "max": "1.3125rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "1.875rem" } },
				{ "slug": "xx-large", "name": "2X large", "size": "2.5rem", "fluid": { "min": "2rem", "max": "3.25rem" } }
			]
		},
		"spacing": {
			"spacingSizes": [
				{ "slug": "20", "name": "1", "size": "0.5rem" },
				{ "slug": "30", "name": "2", "size": "0.75rem" },
				{ "slug": "40", "name": "3", "size": "1rem" },
				{ "slug": "50", "name": "4", "size": "1.5rem" },
				{ "slug": "60", "name": "5", "size": "clamp(2rem, 1.4rem + 2.4vw, 3.5rem)" },
				{ "slug": "70", "name": "6", "size": "clamp(3rem, 2rem + 4vw, 5.5rem)" },
				{ "slug": "80", "name": "7", "size": "clamp(4rem, 2.8rem + 6vw, 7.5rem)" }
			]
		},
		"shadow": {
			"presets": [
				{ "slug": "sm", "name": "Small", "shadow": "none" },
				{ "slug": "md", "name": "Medium", "shadow": "none" }
			]
		},
		"custom": {
			"radius": {
				"sm": "0",
				"md": "0",
				"lg": "0",
				"pill": "0"
			},
			"line": "1px solid var(--wp--preset--color--contrast)",
			"card": {
				"background": "transparent",
				"border": "1px solid var(--wp--preset--color--contrast)",
				"radius": "var(--wp--custom--radius--md)",
				"padding": "var(--wp--preset--spacing--50)",
				"shadow": "none",
				"hoverShadow": "none",
				"hoverTransform": "none"
			},
			"input": {
				"border": "1px solid var(--wp--preset--color--contrast)"
			},
			"header": {
				"background": "var(--wp--preset--color--base)"
			},
			"footer": {
				"background": "var(--wp--preset--color--base)",
				"color": "inherit"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|system-serif",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.75"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|60"
		},
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|accent" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var:preset|color|muted" }
				}
			},
			"heading": {
				"color": { "text": "var:preset|color|contrast" },
				"typography": {
					"fontFamily": "var:preset|font-family|system-serif",
					"fontWeight": "400",
					"lineHeight": "1.2",
					"letterSpacing": "-0.02em"
				}
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|xx-large" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|large" } },
			"h4": { "typography": { "fontSize": "var:preset|font-size|medium" } },
			"h5": { "typography": { "fontSize": "var:preset|font-size|medium" } },
			"h6": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"letterSpacing": "0.08em",
					"textTransform": "uppercase"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|base",
					"text": "var:preset|color|contrast"
				},
				"border": {
					"radius": "var(--wp--custom--radius--md)",
					"width": "1px",
					"style": "solid",
					"color": "var:preset|color|contrast"
				},
				"shadow": "var:preset|shadow|sm",
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "400",
					"letterSpacing": "0.08em",
					"textDecoration": "none",
					"textTransform": "uppercase"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|contrast",
						"text": "var:preset|color|base"
					},
					"border": { "color": "var:preset|color|contrast" },
					"shadow": "var:preset|shadow|sm"
				},
				":active": {
					"color": {
						"background": "var:preset|color|contrast",
						"text": "var:preset|color|base"
					},
					"border": { "color": "var:preset|color|contrast" },
					"shadow": "var:preset|shadow|sm"
				}
			},
			"caption": {
				"color": { "text": "var:preset|color|muted" },
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontStyle": "italic"
				}
			},
			"cite": {
				"color": { "text": "var:preset|color|muted" },
				"typography": {
					"fontStyle": "italic",
					"fontWeight": "400"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontWeight": "400",
					"letterSpacing": "-0.01em"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"letterSpacing": "0.08em",
					"textTransform": "uppercase"
				},
				"elements": {
					"link": {
						"color": { "text": "var:preset|color|contrast" },
						"typography": { "textDecoration": "none" },
						":hover": {
							"color": { "text": "var:preset|color|contrast" },
							"typography": { "textDecoration": "underline" }
						}
					}
				}
			},
			"core/post-title": {
				"typography": {
					"fontWeight": "400",
					"lineHeight": "1.2"
				},
				"elements": {
					"link": {
						"color": { "text": "var:preset|color|contrast" },
						"typography": { "textDecoration": "none" },
						":hover": {
							"color": { "text": "var:preset|color|contrast" },
							"typography": { "textDecoration": "underline" }
						}
					}
				}
			},
			"core/post-date": {
				"color": { "text": "var:preset|color|muted" },
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"letterSpacing": "0.08em",
					"textTransform": "uppercase"
				}
			},
			"core/post-excerpt": {
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"lineHeight": "1.75"
				}
			},
			"core/query-title": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large",
					"fontWeight": "400",
					"letterSpacing": "-0.02em"
				}
			},
			"core/image": {
				"border": { "radius": "var(--wp--custom--radius--md)" },
				"shadow": "var:preset|shadow|sm"
			},
			"core/post-featured-image": {
				"border": { "radius": "var(--wp--custom--radius--md)" },
				"shadow": "var:preset|shadow|sm"
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var:preset|color|contrast",
						"style": "solid",
						"width": "2px"
					}
				},
				"spacing": {
					"padding": { "left": "var:preset|spacing|40" }
				},
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"fontStyle": "italic"
				}
			},
			"core/pullquote": {
				"border": {
					"top": {
						"color": "var:preset|color|contrast",
						"style": "solid",
						"width": "1px"
					},
					"bottom": {
						"color": "var:preset|color|contrast",
						"style": "solid",
						"width": "1px"
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|x-large",
					"fontStyle": "italic"
				}
			},
			"core/separator": {
				"border": {
					"top": {
						"color": "currentColor",
						"style": "solid",
						"width": "1px"
					}
				}
			},
			"core/code": {
				"color": {
					"background": "var:preset|color|surface",
					"text": "var:preset|color|contrast"
				},
				"border": { "radius": "var(--wp--custom--radius--md)" },
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|40",
						"right": "var:preset|spacing|40",
						"bottom": "var:preset|spacing|40",
						"left": "var:preset|spacing|40"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|system-mono",
					"fontSize": "var:preset|font-size|small"
				}
			},
			"core/search": {
				"border": { "radius": "var(--wp--custom--radius--md)" }
			},
			"core/query-pagination": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"letterSpacing": "0.08em",
					"textTransform": "uppercase"
				},
				"spacing": { "blockGap": "var:preset|spacing|40" }
			}
		}
	}
}
