{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Dark",
	"settings": {
		"layout": {
			"contentSize": "45rem",
			"wideSize": "75rem"
		},
		"color": {
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#0f172a" },
				{ "slug": "surface", "name": "Surface", "color": "#1e293b" },
				{ "slug": "contrast", "name": "Contrast", "color": "#f1f5f9" },
				{ "slug": "muted", "name": "Muted", "color": "#94a3b8" },
				{ "slug": "accent", "name": "Accent", "color": "#a5b4fc" },
				{ "slug": "accent-contrast", "name": "Accent contrast", "color": "#0f172a" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "system-sans",
					"name": "System Sans",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "system-serif",
					"name": "System Serif",
					"fontFamily": "Georgia, \"Times New Roman\", serif"
				},
				{
					"slug": "system-mono",
					"name": "System Mono",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "medium", "name": "Medium", "size": "1rem" },
				{ "slug": "large", "name": "Large", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "2rem" } },
				{ "slug": "xx-large", "name": "2X large", "size": "2.5rem", "fluid": { "min": "2rem", "max": "3.5rem" } }
			]
		},
		"spacing": {
			"spacingSizes": [
				{ "slug": "20", "name": "1", "size": "0.5rem" },
				{ "slug": "30", "name": "2", "size": "0.75rem" },
				{ "slug": "40", "name": "3", "size": "1rem" },
				{ "slug": "50", "name": "4", "size": "1.5rem" },
				{ "slug": "60", "name": "5", "size": "clamp(1.5rem, 1.1rem + 1.6vw, 2.5rem)" },
				{ "slug": "70", "name": "6", "size": "clamp(2.5rem, 1.7rem + 3.2vw, 4rem)" },
				{ "slug": "80", "name": "7", "size": "clamp(3.5rem, 2.3rem + 4.8vw, 6rem)" }
			]
		},
		"shadow": {
			"presets": [
				{ "slug": "sm", "name": "Small", "shadow": "0 0 12px color-mix(in srgb, var(--wp--preset--color--accent) 25%, transparent)" },
				{ "slug": "md", "name": "Medium", "shadow": "0 0 24px color-mix(in srgb, var(--wp--preset--color--accent) 30%, transparent)" }
			]
		},
		"custom": {
			"radius": {
				"sm": "0.375rem",
				"md": "0.75rem",
				"lg": "1.5rem",
				"pill": "999px"
			},
			"line": "1px solid color-mix(in srgb, var(--wp--preset--color--muted) 35%, transparent)",
			"card": {
				"background": "var(--wp--preset--color--surface)",
				"border": "1px solid color-mix(in srgb, var(--wp--preset--color--muted) 35%, transparent)",
				"radius": "var(--wp--custom--radius--lg)",
				"padding": "var(--wp--preset--spacing--50)",
				"shadow": "var(--wp--preset--shadow--md)",
				"hoverShadow": "0 0 32px color-mix(in srgb, var(--wp--preset--color--accent) 50%, transparent)",
				"hoverTransform": "translateY(-2px)"
			},
			"input": {
				"border": "1px solid var(--wp--preset--color--muted)"
			},
			"header": {
				"background": "var(--wp--preset--color--base)"
			},
			"footer": {
				"background": "var(--wp--preset--color--surface)",
				"color": "inherit"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|system-sans",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|50"
		},
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|accent" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var:preset|color|contrast" }
				}
			},
			"heading": {
				"color": { "text": "var:preset|color|contrast" },
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.2",
					"letterSpacing": "-0.01em"
				}
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|xx-large" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|large" } },
			"h4": { "typography": { "fontSize": "var:preset|font-size|medium" } },
			"h5": { "typography": { "fontSize": "var:preset|font-size|medium" } },
			"h6": { "typography": { "fontSize": "var:preset|font-size|small" } },
			"button": {
				"color": {
					"background": "var:preset|color|accent",
					"text": "var:preset|color|accent-contrast"
				},
				"border": {
					"radius": "var(--wp--custom--radius--pill)",
					"width": "1px",
					"style": "solid",
					"color": "var:preset|color|accent"
				},
				"shadow": "var:preset|shadow|sm",
				"typography": {
					"fontWeight": "600",
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|contrast",
						"text": "var:preset|color|base"
					},
					"border": { "color": "var:preset|color|contrast" },
					"shadow": "var:preset|shadow|md"
				},
				":active": {
					"color": {
						"background": "var:preset|color|contrast",
						"text": "var:preset|color|base"
					},
					"border": { "color": "var:preset|color|contrast" },
					"shadow": "var:preset|shadow|sm"
				}
			},
			"caption": {
				"color": { "text": "var:preset|color|muted" },
				"typography": { "fontSize": "var:preset|font-size|small" }
			},
			"cite": {
				"color": { "text": "var:preset|color|muted" },
				"typography": {
					"fontStyle": "normal",
					"fontWeight": "600"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontWeight": "700",
					"letterSpacing": "-0.01em"
				}
			},
			"core/navigation": {
				"typography": { "fontWeight": "500" },
				"elements": {
					"link": {
						"color": { "text": "var:preset|color|contrast" },
						"typography": { "textDecoration": "none" },
						":hover": {
							"color": { "text": "var:preset|color|accent" },
							"typography": { "textDecoration": "none" }
						}
					}
				}
			},
			"core/post-title": {
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.25"
				},
				"elements": {
					"link": {
						"color": { "text": "var:preset|color|contrast" },
						"typography": { "textDecoration": "none" },
						":hover": {
							"color": { "text": "var:preset|color|accent" },
							"typography": { "textDecoration": "none" }
						}
					}
				}
			},
			"core/post-date": {
				"color": { "text": "var:preset|color|muted" },
				"typography": { "fontSize": "var:preset|font-size|small" }
			},
			"core/post-excerpt": {
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"lineHeight": "1.6"
				}
			},
			"core/query-title": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large",
					"fontWeight": "700"
				}
			},
			"core/image": {
				"border": {
					"color": "color-mix(in srgb, var(--wp--preset--color--muted) 35%, transparent)",
					"radius": "var(--wp--custom--radius--lg)",
					"style": "solid",
					"width": "1px"
				},
				"shadow": "var:preset|shadow|sm"
			},
			"core/post-featured-image": {
				"border": {
					"color": "color-mix(in srgb, var(--wp--preset--color--muted) 35%, transparent)",
					"radius": "var(--wp--custom--radius--lg)",
					"style": "solid",
					"width": "1px"
				},
				"shadow": "var:preset|shadow|sm"
			},
			"core/quote": {
				"color": { "background": "var:preset|color|surface" },
				"border": {
					"left": {
						"color": "var:preset|color|accent",
						"style": "solid",
						"width": "4px"
					}
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|40",
						"right": "var:preset|spacing|40",
						"bottom": "var:preset|spacing|40",
						"left": "var:preset|spacing|40"
					}
				}
			},
			"core/pullquote": {
				"border": {
					"top": {
						"color": "var:preset|color|accent",
						"style": "solid",
						"width": "2px"
					},
					"bottom": {
						"color": "var:preset|color|accent",
						"style": "solid",
						"width": "2px"
					}
				},
				"typography": { "fontSize": "var:preset|font-size|large" }
			},
			"core/separator": {
				"border": {
					"top": {
						"color": "currentColor",
						"style": "solid",
						"width": "1px"
					}
				}
			},
			"core/code": {
				"color": {
					"background": "var:preset|color|surface",
					"text": "var:preset|color|contrast"
				},
				"border": { "radius": "var(--wp--custom--radius--md)" },
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|40",
						"right": "var:preset|spacing|40",
						"bottom": "var:preset|spacing|40",
						"left": "var:preset|spacing|40"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|system-mono",
					"fontSize": "var:preset|font-size|small"
				}
			},
			"core/search": {
				"border": { "radius": "var(--wp--custom--radius--pill)" }
			},
			"core/query-pagination": {
				"typography": { "fontWeight": "500" },
				"spacing": { "blockGap": "var:preset|spacing|30" }
			}
		}
	}
}
