{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "45rem",
			"wideSize": "75rem"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#ffffff" },
				{ "slug": "surface", "name": "Surface", "color": "#f4f5f7" },
				{ "slug": "contrast", "name": "Contrast", "color": "#111827" },
				{ "slug": "muted", "name": "Muted", "color": "#4b5563" },
				{ "slug": "accent", "name": "Accent", "color": "#1d4ed8" },
				{ "slug": "accent-contrast", "name": "Accent contrast", "color": "#ffffff" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "system-sans",
					"name": "System Sans",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "system-serif",
					"name": "System Serif",
					"fontFamily": "Georgia, \"Times New Roman\", serif"
				},
				{
					"slug": "system-mono",
					"name": "System Mono",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "medium", "name": "Medium", "size": "1rem" },
				{ "slug": "large", "name": "Large", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "2rem" } },
				{ "slug": "xx-large", "name": "2X large", "size": "2.5rem", "fluid": { "min": "2rem", "max": "3.5rem" } }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "em", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "1", "size": "0.5rem" },
				{ "slug": "30", "name": "2", "size": "0.75rem" },
				{ "slug": "40", "name": "3", "size": "1rem" },
				{ "slug": "50", "name": "4", "size": "1.5rem" },
				{ "slug": "60", "name": "5", "size": "clamp(1.5rem, 1.1rem + 1.6vw, 2.5rem)" },
				{ "slug": "70", "name": "6", "size": "clamp(2.5rem, 1.7rem + 3.2vw, 4rem)" },
				{ "slug": "80", "name": "7", "size": "clamp(3.5rem, 2.3rem + 4.8vw, 6rem)" }
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "sm", "name": "Small", "shadow": "0 1px 2px rgb(17 24 39 / 0.10)" },
				{ "slug": "md", "name": "Medium", "shadow": "0 4px 12px rgb(17 24 39 / 0.12)" }
			]
		},
		"custom": {
			"radius": {
				"sm": "0.25rem",
				"md": "0.5rem",
				"lg": "1rem",
				"pill": "999px"
			},
			"line": "none",
			"card": {
				"background": "transparent",
				"border": "none",
				"radius": "var(--wp--custom--radius--md)",
				"padding": "0",
				"shadow": "none",
				"hoverShadow": "none",
				"hoverTransform": "none"
			},
			"input": {
				"border": "1px solid var(--wp--preset--color--muted)"
			},
			"header": {
				"background": "transparent"
			},
			"footer": {
				"background": "var(--wp--preset--color--surface)",
				"color": "inherit"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|system-sans",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|50",
			"padding": {
				"left": "var:preset|spacing|50",
				"right": "var:preset|spacing|50"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|accent" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var:preset|color|contrast" }
				}
			},
			"heading": {
				"color": { "text": "var:preset|color|contrast" },
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|xx-large" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|large" } },
			"h4": { "typography": { "fontSize": "var:preset|font-size|medium" } },
			"h5": { "typography": { "fontSize": "var:preset|font-size|medium" } },
			"h6": { "typography": { "fontSize": "var:preset|font-size|small" } },
			"button": {
				"color": {
					"background": "var:preset|color|accent",
					"text": "var:preset|color|accent-contrast"
				},
				"border": { "radius": "var(--wp--custom--radius--md)" },
				"spacing": {
					"padding": {
						"top": "0.75em",
						"right": "1.5em",
						"bottom": "0.75em",
						"left": "1.5em"
					}
				},
				"typography": {
					"fontWeight": "600",
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|contrast",
						"text": "var:preset|color|base"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": { "fontWeight": "700" },
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						"color": { "text": "inherit" }
					}
				}
			},
			"core/navigation": {
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						"color": { "text": "var:preset|color|contrast" },
						":hover": {
							"typography": { "textDecoration": "underline" }
						}
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						"color": { "text": "var:preset|color|contrast" },
						":hover": {
							"typography": { "textDecoration": "underline" }
						}
					}
				}
			},
			"core/template-part": {
				"css": "&:is(header){background:var(--wp--custom--header--background);border-bottom:var(--wp--custom--line)} &:is(footer){background:var(--wp--custom--footer--background);color:var(--wp--custom--footer--color);border-top:var(--wp--custom--line)} &:is(footer) a{color:inherit} &:is(footer) :is(h1,h2,h3,h4,h5,h6){color:inherit}"
			},
			"core/post-template": {
				"css": "& > li{background:var(--wp--custom--card--background);border:var(--wp--custom--card--border);border-radius:var(--wp--custom--card--radius);padding:var(--wp--custom--card--padding);box-shadow:var(--wp--custom--card--shadow);transition:transform .15s ease-out,box-shadow .15s ease-out} & > li:hover{box-shadow:var(--wp--custom--card--hover-shadow);transform:var(--wp--custom--card--hover-transform)}"
			},
			"core/query-pagination": {
				"css": "& .wp-block-query-pagination-numbers a.page-numbers, .wp-block-query-pagination-numbers .page-numbers.current, .wp-block-query-pagination-previous, .wp-block-query-pagination-next{display:inline-block;padding:0.25em 0.75em;background:var(--wp--custom--card--background);border:var(--wp--custom--card--border);border-radius:var(--wp--custom--radius--md);color:var(--wp--preset--color--contrast);text-decoration:none} & .wp-block-query-pagination-numbers a.page-numbers:hover, .wp-block-query-pagination-numbers .page-numbers.current, .wp-block-query-pagination-previous:hover, .wp-block-query-pagination-next:hover{background:var(--wp--preset--color--contrast);border-color:var(--wp--preset--color--contrast);color:var(--wp--preset--color--base)} & .wp-block-query-pagination-numbers .page-numbers.dots{padding:0.25em 0.5em}"
			},
			"core/table": {
				"css": "border:var(--wp--custom--card--border); & :is(th,td){border:var(--wp--custom--input--border)} & thead th{background:var(--wp--preset--color--surface)}"
			},
			"core/search": {
				"css": "& .wp-block-search__input{background-color:var(--wp--preset--color--base);color:var(--wp--preset--color--contrast)} &:not(.wp-block-search__button-inside) .wp-block-search__input{border:var(--wp--custom--input--border);padding:0.5em 0.75em} &.wp-block-search__button-inside .wp-block-search__inside-wrapper{background-color:var(--wp--preset--color--base);border:var(--wp--custom--input--border)}"
			}
		},
		"css": ":where(a, button, input, select, textarea, summary):focus-visible{outline:2px solid var(--wp--preset--color--accent);outline-offset:2px}@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}"
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
