			"Bash(git commit)",
			"Bash(git commit *)",
			"Bash(git push *)",
			"Bash(git merge *)",
			"Bash(git rebase *)",
			"Bash(git checkout *)",
			"Bash(git restore *)",
			"Bash(git reset *)",
			"Bash(git tag *)",
			"Bash(git cherry-pick *)",
			"Bash(git revert *)",

			"Bash(mysql *)",
			"Bash(wp db query *)",
			"Bash(wp db import *)",
			"Bash(wp search-replace *)",
			"Bash(wp eval *)",
			"Bash(wp eval-file *)",
			"Bash(wp shell *)",
			"Bash(wp core install *)",
			"Bash(wp post delete *)",
			"Bash(wp term delete *)",
			"Bash(wp user delete *)",
			"Bash(wp option delete *)",
			"Bash(wp comment delete *)",
			"Bash(wp plugin delete *)",
			"Bash(wp plugin uninstall *)",
			"Bash(wp theme delete *)"
