			"Bash(sudo *)",
			"Bash(chmod -R *)",
			"Bash(chown -R *)",
			"Bash(curl * | *)",
			"Bash(wget * | *)",

			"Bash(git push --force*)",
			"Bash(git push -f*)",
			"Bash(git push * --force*)",
			"Bash(git push * -f*)",
			"Bash(git reset --hard*)",
			"Bash(git clean *)",
			"Bash(git branch -D *)",
			"Bash(git filter-branch *)",
			"Bash(git update-ref -d *)",
			"Bash(git * --no-verify*)",

			"Bash(npm publish*)",
			"Bash(npm install -g *)",
			"Bash(npm i -g *)",
			"Bash(composer global *)",

			"Bash(wp db drop *)",
			"Bash(wp db reset *)",
			"Bash(wp db clean *)",
			"Bash(wp site empty *)",
			"Bash(wp site delete *)",
			"Bash(wp config *)",

			"Read(**/wp-config.php)",
			"Read(**/wp-config-*.php)",
			"Read(**/.env)",
			"Read(**/.env.*)",
			"Read(**/*.pem)",
			"Read(**/*.key)",
			"Read(**/*.crt)",
			"Read(**/*.cer)",
			"Read(**/*.p12)",
			"Read(**/*.pfx)",
			"Read(**/*.jks)",
			"Read(**/id_rsa*)",
			"Read(**/id_ed25519*)",
			"Read(**/*.sql)",
			"Read(**/*.sql.gz)",
			"Read(**/uploads/**)",
			"Read(**/.git/**)",

			"Bash(*wp-config*)",
			"Bash(* .env)",
			"Bash(* .env.*)",
			"Bash(*/.env)",
			"Bash(*/.env.*)"
		]
	}
}
