			"Bash(npm run *)",
			"Bash(npm test *)",
			"Bash(npm ls *)",
			"Bash(npm outdated *)",
			"Bash(npm audit *)",
			"Bash(npx wp-scripts *)",
			"Bash(npx eslint *)",
			"Bash(npx stylelint *)",

			"Bash(composer install)",
