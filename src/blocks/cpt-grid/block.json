{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "glinf/cpt-grid",
	"version": "0.1.0",
	"title": "CPT Grid",
	"category": "design",
	"icon": "grid-view",
	"description": "A responsive grid of posts from any public post type, with optional taxonomy filter. Cards follow the active Style Variation.",
	"keywords": [ "grid", "posts", "cpt", "custom post type", "query", "cards" ],
	"textdomain": "gl-infinite-theme",
	"attributes": {
		"postType": {
			"type": "string",
			"default": "post"
		},
		"postsPerPage": {
			"type": "integer",
			"minimum": 1,
			"maximum": 24,
			"default": 6
		},
		"columns": {
			"type": "integer",
			"minimum": 1,
			"maximum": 6,
			"default": 3
		},
		"orderBy": {
			"type": "string",
			"enum": [ "date", "title", "modified", "menu_order" ],
			"default": "date"
		},
		"order": {
			"type": "string",
			"enum": [ "ASC", "DESC" ],
			"default": "DESC"
		},
		"taxonomy": {
			"type": "string",
			"default": ""
		},
		"termId": {
			"type": "integer",
			"minimum": 0,
			"default": 0
		},
		"showImage": {
			"type": "boolean",
			"default": true
		},
		"showExcerpt": {
			"type": "boolean",
			"default": true
		},
		"showDate": {
			"type": "boolean",
			"default": true
		},
		"titleLevel": {
			"type": "integer",
			"enum": [ 2, 3, 4, 5, 6 ],
			"default": 3
		}
	},
	"example": {
		"attributes": {
			"postsPerPage": 3,
			"columns": 3
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
