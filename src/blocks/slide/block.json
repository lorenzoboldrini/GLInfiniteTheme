{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "glinf/slide",
	"version": "0.1.0",
	"title": "Slide",
	"category": "design",
	"icon": "images-alt2",
	"description": "One slide of a Slider. It holds any blocks. The look follows the active Style Variation.",
	"keywords": [ "slide", "slider", "carousel" ],
	"textdomain": "gl-infinite-theme",
	"parent": [ "glinf/slider" ],
	"attributes": {
		"label": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"inserter": false,
		"reusable": false,
		"anchor": true,
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"spacing": {
			"padding": true,
			"blockGap": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": true,
		"layout": {
			"default": {
				"type": "default"
			},
			"allowEditing": false
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
