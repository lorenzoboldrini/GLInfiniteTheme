{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "glinf/stat",
	"version": "0.1.0",
	"title": "Stat",
	"category": "design",
	"icon": "chart-line",
	"description": "One figure of a Stats Counter: a number with an optional prefix and suffix, and the label that names it. The look follows the active Style Variation.",
	"keywords": [ "stat", "number", "figure", "counter", "metric" ],
	"textdomain": "gl-infinite-theme",
	"parent": [ "glinf/stats-counter" ],
	"usesContext": [ "glinf/statsDuration" ],
	"attributes": {
		"value": {
			"type": "number",
			"minimum": 0,
			"maximum": 1000000000000,
			"default": 0
		},
		"decimals": {
			"type": "integer",
			"minimum": 0,
			"maximum": 3,
			"default": 0
		},
		"prefix": {
			"type": "string",
			"default": ""
		},
		"suffix": {
			"type": "string",
			"default": ""
		},
		"label": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"inserter": false,
		"reusable": false,
		"anchor": true,
		"color": {
			"background": true,
			"text": true
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
