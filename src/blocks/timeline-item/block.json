{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "glinf/timeline-item",
	"version": "0.1.0",
	"title": "Timeline Item",
	"category": "design",
	"icon": "editor-ol",
	"description": "One step of a Timeline: a date or label, a title and any blocks. The look follows the active Style Variation.",
	"keywords": [ "timeline", "step", "event", "milestone" ],
	"textdomain": "gl-infinite-theme",
	"parent": [ "glinf/timeline" ],
	"usesContext": [ "glinf/timelineTitleLevel" ],
	"attributes": {
		"label": {
			"type": "string",
			"default": ""
		},
		"title": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"inserter": false,
		"reusable": false,
		"anchor": true,
		"color": {
			"background": false,
			"text": true,
			"link": true
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
