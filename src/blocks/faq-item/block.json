{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "glinf/faq-item",
	"version": "0.1.0",
	"title": "FAQ Item",
	"category": "design",
	"icon": "arrow-down-alt2",
	"description": "One question of a FAQ Accordion: the question and its answer, which can hold any blocks. The look follows the active Style Variation.",
	"keywords": [ "faq", "question", "answer", "accordion" ],
	"textdomain": "gl-infinite-theme",
	"parent": [ "glinf/faq-accordion" ],
	"usesContext": [ "glinf/faqTitleLevel" ],
	"attributes": {
		"question": {
			"type": "string",
			"default": ""
		},
		"open": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"inserter": false,
		"reusable": false,
		"anchor": true,
		"color": {
			"background": true,
			"text": true,
			"link": true
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
